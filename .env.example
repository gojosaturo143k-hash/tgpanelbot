# ------------------------------------------------------------------
# Telegram Bot Backend - Environment Variables (example)
# Copy this file to ".env" for local development and fill the values.
# NEVER commit your real ".env" file or real secrets to git.
# ------------------------------------------------------------------

# Token from @BotFather. Required for the bot to receive/send messages.
TELEGRAM_BOT_TOKEN=

# PostgreSQL connection string.
# Local example:  postgresql://postgres:postgres@localhost:5432/telegram_bot
# Render example: postgresql://USER:PASSWORD@HOST/DBNAME
DATABASE_URL=

# Secret key the Web Panel must send as:  Authorization: Bearer <PANEL_API_KEY>
# Generate a long random string, e.g.:  openssl rand -hex 32
PANEL_API_KEY=

# Origin of your Netlify Web Panel (used for CORS). No trailing slash.
# Example: https://my-panel.netlify.app
FRONTEND_ORIGIN=

# HTTP port. Render supplies this automatically - you normally do NOT
# need to set it yourself. Defaults to 10000 when not set.
PORT=
